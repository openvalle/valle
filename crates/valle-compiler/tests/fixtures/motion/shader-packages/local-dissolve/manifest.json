{
  "name": "local-dissolve",
  "entry": "shader.vsksl",
  "inputs": [
    {
      "name": "noise",
      "required": true,
      "sampling": "nearest"
    }
  ],
  "uniforms": [
    {
      "name": "progress",
      "type": "float",
      "required": true,
      "min": 0.0,
      "max": 1.0
    },
    {
      "name": "edgeWidth",
      "type": "float",
      "required": false,
      "default": {
        "kind": "float",
        "value": 0.06
      },
      "min": 0.001,
      "max": 0.25
    },
    {
      "name": "edgeColor",
      "type": "color",
      "required": true
    }
  ],
  "output": {
    "colorSpace": "linear-srgb",
    "alphaMode": "straight",
    "allowTransparent": true
  },
  "budget": "local"
}
