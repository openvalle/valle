// Same ordered depth-aware gathers as valle-motion/scene3d/raster/dof.rs.
uniform shader sharpTiles;

float2 directionAt(int i) {
    if (i == 0) return float2(1,0);
    if (i == 1) return float2(0.70710677,0.70710677);
    if (i == 2) return float2(0,1);
    if (i == 3) return float2(-0.70710677,0.70710677);
    if (i == 4) return float2(-1,0);
    if (i == 5) return float2(-0.70710677,-0.70710677);
    if (i == 6) return float2(0,-1);
    return float2(0.70710677,-0.70710677);
}
const float4 mainRings = float4(0.125,0.25,0.5,1.0);
const float4 weights = float4(4.0,2.0,1.0,0.5);

bool inside(float2 p, float4 bounds) {
    return p.x >= bounds.x && p.y >= bounds.y && p.x < bounds.z && p.y < bounds.w;
}
float linear(float v) { return v <= 0.04045 ? v / 12.92 : pow((v+0.055)/1.055,2.4); }
float srgb(float v) { return v <= 0.0031308 ? v*12.92 : 1.055*pow(v,1.0/2.4)-0.055; }
float4 decode(float4 c) {
    if (c.a == 0.0) return float4(0.0);
    float3 rgb = clamp(c.rgb/c.a,0.0,1.0);
    return float4(float3(linear(rgb.r),linear(rgb.g),linear(rgb.b))*c.a,c.a);
}
float4 encode(float4 c) {
    float alpha = clamp(c.a,0.0,1.0);
    if (alpha == 0.0) return float4(0.0);
    float3 rgb = clamp(c.rgb/alpha,0.0,1.0);
    return float4(float3(srgb(rgb.r),srgb(rgb.g),srgb(rgb.b))*alpha,alpha);
}
float2 rounded(float2 p) { return sign(p)*floor(abs(p)+0.5); }

half4 main(float2 xy) {
    float2 p = floor(xy);
    float4 raw = float4(source.eval(p+0.5));
    if (!inside(p,visibleBounds) || sharpTiles.eval(floor(p / 16.0) + 0.5).r > 0.5) return half4(raw);
    float centerDepth = depthAt(p);
    float radius = coc(centerDepth);
    float tolerance = max(centerDepth*0.005,0.005);
    float4 original = decode(raw);
    float4 color = original;
    if (radius >= 0.75) {
        float4 sum = original;
        float count = 1.0;
        for (int ring=0; ring<4; ++ring) {
            for (int direction=0; direction<8; ++direction) {
                float2 q = rounded(p + directionAt(direction)*radius*mainRings[ring]);
                if (!inside(q,float4(0.0,0.0,size.x,size.y))) continue;
                float z = depthAt(q);
                if (centerDepth < focus && z > centerDepth+tolerance) continue;
                if (z < centerDepth-tolerance) {
                    if (z <= focus || length(q-p) > coc(z)) continue;
                }
                sum += decode(float4(source.eval(q+0.5)));
                count += 1.0;
            }
        }
        color = sum / count;
    }
    if (inside(p,nearBounds)) {
        float4 radii = float4(1.0,maxRadius/3.0,maxRadius*2.0/3.0,maxRadius);
        float4 sum = float4(0.0);
        for (int ring=0; ring<4; ++ring) {
            for (int direction=0; direction<8; ++direction) {
                float2 q = rounded(p + directionAt(direction)*radii[ring]);
                if (!inside(q,float4(0.0,0.0,size.x,size.y))) continue;
                float z = depthAt(q);
                if (z >= focus || z >= centerDepth-tolerance) continue;
                float4 c = float4(source.eval(q+0.5));
                if (c.a == 0.0 || length(q-p) > coc(z)) continue;
                sum += decode(c)*weights[ring];
            }
        }
        float4 nearColor = sum / 60.0;
        if (nearColor.a > 0.0) color = nearColor + color*(1.0-nearColor.a);
    }
    if (radius < 0.75 && color == original) return half4(raw);
    return half4(encode(color));
}
