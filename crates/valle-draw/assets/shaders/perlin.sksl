// Reveal pixels in value-noise order using a hash and bilinear interpolation.
uniform shader from_tex;
uniform shader to_tex;
uniform float2 resolution;
uniform float progress;
// Resolved slots are defined by TransitionKind::parameter_specs in Rust.
uniform float4 params;

float lattice_mod(float n) {
    return n - floor(n * (1.0 / 1024.0)) * 1024.0;
}

float hash21(float2 p) {
    // Exact integer arithmetic expressed with ES2-compatible floats. Every product is
    // below 2^24 and power-of-two reduction avoids platform-sensitive fract(x*y).
    float h = lattice_mod(p.x * 157.0 + p.y * 113.0);
    h = lattice_mod(h * (h + 31.0));
    h = lattice_mod(h * (h + 71.0));
    return h * (1.0 / 1024.0);
}

float value_noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

half4 main(float2 xy) {
    if (progress <= 0.0) return from_tex.eval(xy);
    if (progress >= 1.0) return to_tex.eval(xy);
    float2 uv = xy / resolution;
    // Noise frequency controls patch size.
    float n = value_noise(uv * params.x);
    // Soften the reveal boundary around the current progress.
    float front = -params.y + progress * (1.0 + 2.0 * params.y);
    float t = smoothstep(n - params.y, n + params.y, front);
    half4 a = from_tex.eval(xy);
    half4 b = to_tex.eval(xy);
    return mix(a, b, half(t));
}
