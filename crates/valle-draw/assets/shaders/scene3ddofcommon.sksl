// Shared full-resolution depth contract for the DOF gather and tile classifier.
uniform shader source;
uniform shader packedDepth;
uniform float2 size;
uniform float focus;
uniform float maxRadius;
uniform float4 visibleBounds;
uniform float4 nearBounds;
uniform float farPlane;

float depthAt(float2 p) {
    float4 b = floor(float4(packedDepth.eval(p + 0.5)) * 255.0 + 0.5);
    float exponent = b.w * 2.0 + floor(b.z / 128.0);
    float mantissa = mod(b.z,128.0)*65536.0 + b.y*256.0 + b.x;
    // Raw CPU depth uses f32::MAX for uncovered pixels; it is not geometry.
    if (exponent == 254.0 && mantissa == 8388607.0) return farPlane;
    return exponent == 0.0 ? (mantissa / 8388608.0) * exp2(-126.0)
        : (1.0 + mantissa / 8388608.0) * exp2(exponent - 127.0);
}
float coc(float depth) { return min(maxRadius * abs(1.0 - focus / depth), maxRadius); }
