// Reveal the destination through an expanding circle centered on the frame.
uniform shader from_tex;
uniform shader to_tex;
uniform float2 resolution;
uniform float progress;
// Resolved slots are defined by TransitionKind::parameter_specs in Rust.
uniform float4 params;

half4 main(float2 xy) {
    if (progress <= 0.0) return from_tex.eval(xy);
    if (progress >= 1.0) return to_tex.eval(xy);
    // Measure in pixels so a non-square canvas still reveals a circle.
    float2 center = resolution * params.xy;
    float d = distance(xy, center);
    half4 a = from_tex.eval(xy);
    half4 b = to_tex.eval(xy);
    float r = progress * (length(max(center, resolution - center)) + 2.0 * params.z) - params.z;
    float p = (params.z == 0.0 ? step(r, d) : smoothstep(r - params.z, r + params.z, d));
    // One selects the source outside; zero selects the destination inside.
    return mix(b, a, half(p));
}
