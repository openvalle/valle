  "contract": {
    "adapter": "demucs-source-separation",
    "version": 2,
    "inputs": [
      {
        "name": "mix",
        "dtype": "f32",
        "layout": "nct",
        "shape": [
          1,
          2,
          343980
        ],
        "range": null,
        "description": "Stereo 44.1 kHz audio segment"
      }
    ],
    "outputs": [
      {
        "name": "stems",
        "dtype": "f32",
        "layout": "nsct",
        "shape": [
          1,
          2,
          2,
          343980
        ],
        "range": null,
        "description": "Vocals and instrumental"
      }
    ],
    "preprocess": {
      "sample_rate": 44100,
      "channels": 2,
      "segment_samples": 343980,
      "stride_samples": 257985,
      "overlap": 0.25,
      "last_segment": "right-zero-pad",
      "normalization_reference": "mono reference ref[t] = (left[t] + right[t]) / 2 over the decoded whole track",
      "normalization_mean": "mean = sum(ref) / T",
      "normalization_std": "std = sqrt(sum((ref - mean)^2) / (T - 1)) + 1e-8",
      "overlap_window": "w[i] = (i + 1) / 171990 for 0 <= i < 171990; w[i] = (343980 - i) / 171990 for 171990 <= i < 343980",
      "long_audio": "triangular weighted overlap-add with transition_power=1"
    },
    "postprocess": {
      "stem_order": [
        "vocals",
        "instrumental"
      ],
      "instrumental_definition": "sum(drums,bass,other)",
      "denormalization": {
        "vocals": "output * std + mean",
        "instrumental": "output * std + 3 * mean"
      },
      "long_audio": "divide the weighted sum by accumulated triangular weights",
      "output_length": "crop each reconstructed stem to the original decoded sample count"
    }
  },
