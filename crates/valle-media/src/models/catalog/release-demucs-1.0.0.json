    "notes": [
      "The exporter pins the adefossez/HTDemucs repository revision instead of resolving its moving main branch.",
      "All 533 state tensors match the legacy 955717e8-8726e21a.th checkpoint exactly; the different file hash reflects safetensors serialization.",
      "The ONNX graph aggregates the upstream four sources into vocals and instrumental before iSTFT.",
      "The CoreML graph aggregates the upstream four sources into vocals and instrumental before returning; the host performs STFT, two inverse STFTs, and time-branch addition without source aggregation."
    ]
  },
  "release": {
    "state": "ready",
    "repository": "openvalle/valle-models"
