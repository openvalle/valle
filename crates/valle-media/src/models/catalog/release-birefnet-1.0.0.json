      },
      "profiles": {
        "quality": [
          1024,
          1024
        ],
        "balanced": [
          768,
          768
        ],
        "coarse": [
          512,
          512
        ]
      }
    },
    "postprocess": {
      "clamp": [
        0,
        1
      ],
      "resize_to_source": "bilinear-half-pixel",
      "encoding": "alpha8-png"
    }
  },
