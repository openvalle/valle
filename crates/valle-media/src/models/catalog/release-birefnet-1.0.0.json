      }
    ],
    "notes": [
      "The native ONNX graph uses opset-19 DeformConv and is the CPU/CUDA artifact.",
      "The DirectML candidate lowers deformable convolution to the parity-checked GridSample representation.",
      "Both ONNX artifacts use static QDQ INT8 quantization for the selected linear MatMul subgraph while keeping float32 external tensors.",
      "Final QDQ graphs were verified with ONNX Runtime 1.27.0 and 1.28.0; onnx-ir was used only by rejected INT4 research."
    ]
  },
  "release": {
    "state": "ready",
    "repository": "openvalle/valle-models"
  },
  "contract": {
    "adapter": "birefnet-image-matting",
    "version": 1,
    "inputs": [
      {
        "name": "img",
