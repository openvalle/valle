{
  "canvas": { "width": 160, "height": 90, "fps": 4, "background": "#0f172a" },
  "resources": {
    "photo": "/tests/resources/photo.png",
    "rings": "/tests/resources/rings.png",
    "card": "/tests/resources/timeline/card.motion.tsx"
  },
  "tracks": {
    "visual": [
      {
        "clips": [
          {
            "id": "ground",
            "kind": "solid",
            "color": "#334155",
            "start": 0,
            "duration": 2,
            "position": [40, 45],
            "size": [80, 90]
          }
        ]
      },
      {
        "clips": [
          {
            "id": "photo",
            "kind": "image",
            "src": "photo",
            "fit": "cover",
            "start": 0,
            "duration": 2,
            "position": [80, 45],
            "size": [96, 54],
            "anchor": [0.5, 0.5],
            "rotation": {
              "keyframes": [
                [0, 0, "ease-in-out"],
                [1.75, 90]
              ]
            },
            "scale": {
              "keyframes": [
                [0, [1, 1]],
                [1, [0.5, 0.75]],
                [1.75, [-0.5, 0.75]]
              ]
            },
            "opacity": {
              "keyframes": [
                [0, 1],
                [1, 0.4]
              ],
              "interpolation": "step"
            }
          }
        ]
      },
      {
        "clips": [
          {
            "id": "rings",
            "kind": "image",
            "src": "rings",
            "fit": "fill",
            "start": 0.5,
            "duration": 1,
            "position": [0, 0],
            "anchor": [0, 0],
            "size": [60, 30],
            "blend": "screen"
          }
        ]
      },
      {
        "clips": [
          {
            "id": "card",
            "kind": "motion",
            "component": "card",
            "fit": "fill",
            "start": 0,
            "duration": 2,
            "position": {
              "keyframes": [
                [0, [120, 70], "ease-out"],
                [1, [140, 20]],
                [2, [120, 70]]
              ]
            },
            "size": [40, 20],
            "anchor": [0.5, 0.5],
            "props": {
              "label": "curve",
              "color": {
                "keyframes": [
                  [0, "#ef4444"],
                  [1.75, "#3b82f6"]
                ]
              }
            }
          }
        ]
      }
    ]
  }
}
