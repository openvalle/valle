{
  "canvas": { "width": 160, "height": 90, "fps": 4, "background": "#1e293b" },
  "resources": {
    "counter": "/tests/resources/counter.mp4",
    "photo": "/tests/resources/photo.png",
    "card": "/tests/resources/timeline/card.motion.tsx",
    "badge": "/tests/resources/timeline/badge.motion.tsx",
    "rings": "/tests/resources/rings.png"
  },
  "tracks": {
    "visual": [
      {
        "id": "V1",
        "items": [
          { "id": "red", "kind": "solid", "color": "#ef4444", "duration": 0.25 },
          {
            "id": "fast",
            "kind": "video",
            "src": "counter",
            "trimStart": 0.5,
            "rate": 2,
            "duration": 0.5
          },
          { "gap": 0.25 },
          { "id": "photo", "kind": "image", "src": "photo", "fit": "cover", "duration": 0.25 },
          {
            "id": "card",
            "kind": "motion",
            "component": "card",
            "trimStart": 1,
            "duration": 0.25,
            "props": { "label": "trimmed" },
            "resources": { "picture": "rings" }
          },
          {
            "id": "held",
            "kind": "video",
            "src": "counter",
            "timeMap": [
              [0, 2.5],
              [0.25, 1]
            ],
            "duration": 0.25
          },
          { "id": "off", "kind": "solid", "color": "#ffffff", "duration": 0.25, "enabled": false },
          {
            "id": "looped",
            "kind": "motion",
            "component": "card",
            "trimStart": 1.75,
            "end": "loop",
            "duration": 0.5,
            "props": { "label": "looped", "color": "#6366f1" }
          }
        ]
      },
      {
        "id": "V2",
        "clips": [
          {
            "id": "badge",
            "kind": "motion",
            "component": "badge",
            "start": { "clip": "fast", "offset": 0.25 },
            "duration": 1.5
          }
        ]
      }
    ]
  }
}
