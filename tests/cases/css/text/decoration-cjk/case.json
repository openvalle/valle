{
  "spec": "https://drafts.csswg.org/css-text-decor-4/#text-decoration-skip-ink-property",
  "assertion": "Auto ink skipping keeps CJK glyphs and punctuation continuously decorated, while Latin descenders still make gaps. Solid, double, dotted, dashed and wavy underlines share this rule; an explicit offset moves the line without changing text layout. Transparent glyph fill isolates the decoration pixels without removing the glyph ink used to compute gaps.",
  "at": [0],
  "browser": {
    "selected": "chrome",
    "reason": "All three browsers keep CJK underlines continuous and skip Latin descenders. Their default offsets and wave/dash shapes differ; Chrome is the visual baseline for those details. With transparent glyph fill, dots and dashes match exactly; solid/double lines differ only at 22 endpoint pixels (max 17), and the wave at 869 rasterized edge pixels (max 96). The allowance covers those reviewed edges. The old engine fails with 2531 changed pixels (max 191), including missing CJK segments and pattern restarts at shaping boundaries. This capture uses the environment recorded beside its PNGs; older cases retain their shared capture environment.",
    "pixels": {
      "maxDifference": 100,
      "maxPixels": 950
    }
  },
