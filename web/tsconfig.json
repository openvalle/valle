{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    // CanvasKit references older WebGPU declarations now also provided by TypeScript DOM.
    "skipLibCheck": true,
    "target": "ES2022",
    "types": [
      "bun"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
